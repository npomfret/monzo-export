# Codex command rules for this project.
# Syntax: Starlark. decision precedence: forbidden > prompt > allow.
# Loads only when this project is trusted.

# ---- git: everything except merge / push ----
prefix_rule(
    pattern = ["git"],
    decision = "allow",
    justification = "Local git work is unrestricted in this project.",
)

prefix_rule(
    pattern = ["git", ["merge", "push"]],
    decision = "forbidden",
    justification = "Merging and pushing (all remote write operations) are reserved for the human.",
)

# Global git flags sit between "git" and the subcommand, so exact-prefix
# matching would miss e.g. `git -C . push`. Route those through a prompt.
prefix_rule(
    pattern = ["git", ["-c", "-C", "--git-dir", "--work-tree", "--exec-path", "--namespace", "-P", "--no-pager"]],
    decision = "prompt",
    justification = "A global git flag can conceal a blocked subcommand; confirm manually.",
)

# ---- git history rewriting: confirm before it happens ----
prefix_rule(
    pattern = ["git", "reset"],
    decision = "prompt",
    justification = "reset can discard staged changes or drop commits; confirm manually.",
)

# Only matches --amend directly after "commit". prefix_rule has no way to match
# a flag at an arbitrary position, so `git commit -m msg --amend` is not caught.
prefix_rule(
    pattern = ["git", "commit", "--amend"],
    decision = "prompt",
    justification = "amend rewrites the previous commit; confirm manually.",
)

# ---- gh: GitHub CLI ----
prefix_rule(
    pattern = ["gh", "issue"],
    decision = "allow",
    justification = "Reading and filing issues is expected agent work.",
)

prefix_rule(
    pattern = ["gh", "issue", "delete"],
    decision = "forbidden",
    justification = "Deleting an issue is not reversible from the CLI.",
)

prefix_rule(
    pattern = ["gh", ["repo", "release", "workflow", "run", "api"]],
    decision = "prompt",
    justification = "These reach beyond issues and can change the repo or trigger CI.",
)

prefix_rule(
    pattern = ["gh", ["auth", "secret", "ssh-key"]],
    decision = "forbidden",
    justification = "Credential and secret surfaces are not for the agent.",
)

# ---- npm ----
prefix_rule(
    pattern = ["npm", ["run", "test", "install", "ci", "exec", "ls", "list", "outdated", "why", "audit"]],
    decision = "allow",
    justification = "Run this project's own npm targets.",
)

prefix_rule(
    pattern = ["npm", ["publish", "unpublish", "adduser", "login", "logout", "token", "owner", "access", "dist-tag", "deprecate", "version"]],
    decision = "forbidden",
    justification = "Registry and release operations are not for the agent.",
)
